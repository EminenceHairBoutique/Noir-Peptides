# ════════════════════════════════════════════════════════════════════════
# Noir Peptides — Environment Variables (template)
# Copy to .env.local for local dev; configure the same keys in Vercel for
# Preview + Production. NEVER commit real secrets — .env* is gitignored.
# Variables prefixed VITE_ are exposed to the client bundle; all others are
# server-only (Vercel serverless functions).
# ════════════════════════════════════════════════════════════════════════

# ── Site / SEO (REQUIRED for production) ─────────────────────────────────
# The public production origin. If this is empty or points at localhost, the
# build WARNS and falls back to the production domain (canonicals/OG never leak
# a local address), so a misconfig won't block the Vercel deploy. Set
# SEO_STRICT_SITE_URL=1 to make the build FAIL on a bad value instead.
VITE_SITE_URL=https://www.noirpeptides.com
# SEO_STRICT_SITE_URL=1

# ── Supabase ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (server-trusted pricing + webhook) ────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: pre-created Stripe shipping rate id for US shipping. If unset, the
# checkout endpoint falls back to an inline flat-rate shipping option.
STRIPE_US_SHIPPING_RATE_ID=

# ── Crypto checkout (BTCPay Server — self-hosted, non-custodial) ──────────
# Optional. When unset, the crypto rail returns 503 and the UI degrades.
# PRIMARY rail (honest crypto — the customer knowingly pays in crypto).
# Configure the BTCPay store webhook "Invoice settled" → /api/btcpay/webhook and
# put its secret in BTCPAY_WEBHOOK_SECRET so settlement fulfills orders.
BTCPAY_URL=
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=
BTCPAY_CRYPTO_DISCOUNT_PCT=5

# ── Future payment adapters (provider abstraction — lib/payments) ─────────
# Each rail is OFF until its key is set; checkout shows only live rails
# (GET /api/payments/rails). Honest, underwritten processors only. When a card
# processor is live, Apple/Google Pay ride it as tokenized cards (not a bypass).
HIGHRISK_CARD_API_KEY=
ACH_API_KEY=

# ── IndexNow (Bing/Yandex instant indexing; post-deploy ping) ────────────
INDEXNOW_KEY=

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ── Admin allowlist (legacy fallback; CP2 unifies on profiles.role) ──────
ADMIN_EMAILS=owner@example.com

# ── Anthropic AI (Checkpoint 3; server-only, never in client bundle) ─────
ANTHROPIC_API_KEY=
# Model for all AI endpoints. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Embeddings provider for semantic search (Voyage AI). Optional — semantic
# search degrades to keyword search when unset.
VOYAGE_API_KEY=

# ── Analytics (prepared, not activated — Checkpoint 3) ───────────────────
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# ── Storage bucket for COA / reference uploads ───────────────────────────
SUPABASE_RESEARCH_UPLOAD_BUCKET=research-uploads
