# ════════════════════════════════════════════════════════════════════════
# Noir Peptides — Environment Variables (template)
# Copy to .env.local for local dev; configure the same keys in Vercel for
# Preview + Production. NEVER commit real secrets — .env* is gitignored.
# Variables prefixed VITE_ are exposed to the client bundle; all others are
# server-only (Vercel serverless functions).
# ════════════════════════════════════════════════════════════════════════

# ── Site / SEO (REQUIRED for production) ─────────────────────────────────
# The public production origin. The build (scripts/generate-static-seo.mjs)
# THROWS if this is empty or points at localhost/127.0.0.1, so canonical/OG
# URLs can never leak a local address again. Set this in Vercel Production.
VITE_SITE_URL=https://www.noirpeptides.com

# ── Supabase ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe (server-trusted pricing + webhook) ────────────────────────────
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: pre-created Stripe shipping rate id for US shipping. If unset, the
# checkout endpoint falls back to an inline flat-rate shipping option.
STRIPE_US_SHIPPING_RATE_ID=

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx

# ── Admin allowlist (legacy fallback; CP2 unifies on profiles.role) ──────
ADMIN_EMAILS=owner@example.com

# ── Anthropic AI (Checkpoint 3; server-only, never in client bundle) ─────
ANTHROPIC_API_KEY=
# Embeddings provider for semantic search (Voyage AI). Optional — semantic
# search degrades to keyword search when unset.
VOYAGE_API_KEY=

# ── Analytics (prepared, not activated — Checkpoint 3) ───────────────────
VITE_GA_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# ── Storage bucket for COA / reference uploads ───────────────────────────
SUPABASE_RESEARCH_UPLOAD_BUCKET=research-uploads
