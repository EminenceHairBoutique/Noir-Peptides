{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' *.stripe.com js.stripe.com *.google-analytics.com *.googletagmanager.com connect.facebook.net *.facebook.net; style-src 'self' 'unsafe-inline' fonts.googleapis.com; font-src 'self' data: fonts.gstatic.com; img-src 'self' data: blob: *.supabase.co *.google-analytics.com www.facebook.com; frame-src js.stripe.com *.stripe.com; connect-src 'self' *.supabase.co wss://*.supabase.co *.stripe.com *.google-analytics.com *.analytics.google.com *.googletagmanager.com *.facebook.com graph.facebook.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests;"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "noirpeptides.com"
        }
      ],
      "destination": "https://www.noirpeptides.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/account/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/assistant",
      "destination": "/index.html"
    },
    {
      "source": "/auth/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/cancel",
      "destination": "/index.html"
    },
    {
      "source": "/cart",
      "destination": "/index.html"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/coa/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/collections",
      "destination": "/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/index.html"
    },
    {
      "source": "/drops",
      "destination": "/index.html"
    },
    {
      "source": "/faq",
      "destination": "/index.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/index.html"
    },
    {
      "source": "/help",
      "destination": "/index.html"
    },
    {
      "source": "/home",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/privacy-choices",
      "destination": "/index.html"
    },
    {
      "source": "/products/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/register/attestation",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/returns",
      "destination": "/index.html"
    },
    {
      "source": "/shipping-refunds",
      "destination": "/index.html"
    },
    {
      "source": "/success",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/test-results/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/v/:code",
      "destination": "/index.html"
    },
    {
      "source": "/verify",
      "destination": "/index.html"
    }
  ]
}
